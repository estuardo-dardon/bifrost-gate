[server]
host = "0.0.0.0"
port = 2403

[tls]
cert_path = "/path/to/your/cert"
key_path = "/path/to/your/key"
enabled = true

[auth]
enabled = true
header_name = "x-api-key"
bootstrap_user = "admin"
bootstrap_api_key = "replace-with-strong-secret"

[database]
# Ruta a la base de datos SQLite
# En Linux por defecto se usa /var/lib/bifrost/bifrost.db
# Puede sobrescribirse con la variable de entorno BIFROST_DATABASE_DB_PATH
db_path = "/var/lib/bifrost/bifrost.db"

[strongswan]
# Lock file de swanctl. En desarrollo puedes usar un path relativo,
# en producción lo normal es /var/lib/bifrost/swanctl.lock.
# También se puede sobrescribir con BIFROST_SWANCTL_LOCK_PATH.
lock_path = "/var/lib/bifrost/swanctl.lock"
# Directorio donde se crean los archivos temporales (.tmp) antes del rename atómico.
# Útil cuando el proceso no tiene permisos de escritura en /etc/swanctl/conf.d/.
# Si no se especifica, los .tmp se crean en el mismo directorio que el archivo destino.
# Ejemplo: tmp_dir = "/var/lib/bifrost/tmp"
tmp_dir = "/var/lib/bifrost/tmp"
# Directorio base de la instalación de swanctl.
# Todos los subdirectorios (conf.d/, x509/, x509ca/, private/) se derivan de aquí.
# Por defecto: /etc/swanctl en producción.
# Se puede sobrescribir con la variable de entorno BIFROST_STRONGSWAN_CONF_DIR.
conf_dir = "/etc/swanctl"

[logging]
# Nivel de log para el servicio
# 0 = Desactivado
# 1 = Información (requests, eventos generales)
# 3 = Errores críticos y excepciones
service_level = 1

# Nivel de log para los workers
# 0 = Desactivado
# 1 = Información (actividad del worker)
# 3 = Errores críticos
worker_level = 1

# Archivos de log (usados si journalctl no está disponible)
# Servicio: access log (requests, eventos)
service_access_log = "/var/log/bifrost/service-access.log"
# Servicio: error log (errores, excepciones)
service_error_log = "/var/log/bifrost/service-error.log"
# Workers
worker_log = "/var/log/bifrost/worker.log"

# Si está disponible journalctl, se usa automáticamente
# De lo contrario, se escribe a los archivos configurados arriba
use_journalctl = true

# Capacidad del canal asíncrono (mensajes en cola antes de backpressure)
# Si no se especifica, por defecto 1000
channel_capacity = 1000

# Tamaño en MB para rotar archivos de log (por defecto 10)
rotate_size_mb = 10
